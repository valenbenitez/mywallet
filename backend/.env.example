DATABASE_URL=

# Comma-separated browser origins allowed to call this API (CORS).
# Local defaults (localhost:3000) are always included in code.
# Example production: https://myownwallet.vercel.app
CORS_ORIGIN=

# Auth (JWT — server-only; never expose to the frontend)
JWT_SECRET=
# Optional; default 7d
JWT_EXPIRES_IN=7d

# SANDBOX
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_USDC_TOKEN_ID_MATIC=
CIRCLE_USDC_TOKEN_ID_ETH=
# Ops-only header for /ops/wallet-sets* (never expose to the frontend)
CIRCLE_OPS_TOKEN=

# Transfer amount limits (USDC decimal strings)
TRANSFER_MIN_USDC=5
TRANSFER_MAX_USDC=15000
